// Company-wide MCP servers, synced to every agent globally.
{
  "mcpServers": {
    "analyzer": {
      "command": "uvx",
      "args": ["mcp-server-analyzer"]
    },
    "local-mongodb": {
        "command": "npx",
        "args": [
          "-y",
          "mongodb-mcp-server@latest",
          "--readOnly"
        ],
        "env": {
          "MDB_MCP_CONNECTION_STRING": "mongodb://localhost:27017"
        }
      }
  }
}
// Company-wide rulesync configuration, used by sync.sh for the user-level
// (global) agent configuration. Sources: .rulesync/ in this repo, overlaid by
// .rulesync/ in the personal repo (see config.yaml).
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/download/v24.0.0/config-schema.json",

  // Features per agent.
  // - copilot has no user-level MCP. VS Code's Agent Host reads the Copilot CLI
  //   file (~/.copilot/mcp-config.json) instead, so copilotcli is used for MCP only.
  "targets": {
    "claudecode": ["rules", "skills", "mcp"],
    "copilot": ["rules", "skills"],
    "copilotcli": ["mcp"],
  },

  // sync.sh passes --delete itself, after checking with a dry run that no
  // hand-written files would be deleted.
  "delete": false,

  // External rules and skills, pinned in rulesync.lock.
  // Add one with: npx rulesync@24.0.0 add <owner/repo> --skills <name>
  "sources": [],
}

// Company-wide settings. Each user's config (created by `init`, see README)
// can override any of these keys.
{
  "$schema": "./config.schema.json",

  // Folder in the company and personal repos holding the global sources
  // (<globalDir>/.rulesync/, plus <globalDir>/rulesync.jsonc for external
  // sources). A repo's root .rulesync/ is project-level for that repo only.
  "globalDir": "global",

  // Which agents to generate for ("global" and "projects") is up to each
  // user and set in their own config, see `init`.

  // Every source rule and SKILL.md must contain this text. Generated files
  // inherit it, which tells them apart from hand-written ones.
  "marker": "<!-- generated by breezelabs-agents: edit the source in the company, personal or project .rulesync/ folder -->",

  // Git hooks installed by `install-hooks`.
  "gitHooks": ["post-checkout", "post-merge", "post-commit"],
}

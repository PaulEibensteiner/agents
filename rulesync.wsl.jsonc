// Used by sync.sh on WSL when wsl_windows_home is set in config.yaml: writes
// the VS Code (Copilot) user-level files a second time into the Windows home
// folder, for VS Code windows opened on Windows folders. Windows connected to
// WSL, and Claude Code inside WSL, read the Linux home.
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/download/v24.0.0/config-schema.json",

  "targets": {
    "copilot": ["rules", "skills"],
    "copilotcli": ["mcp"],
  },

  "delete": false,
}
